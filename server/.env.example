HOST=0.0.0.0
PORT=3000

# Generate a long random token used only to access the Jarvis backend.
# Never reuse your AIsa API key as this token.
JARVIS_AUTH_TOKEN=replace-with-a-long-random-secret

# Keep the AIsa credential only in the server's secret/environment settings.
AISA_API_KEY=replace-with-a-new-key-from-the-AIsa-dashboard
AISA_BASE_URL=https://api.aisa.one/v1
# Set this to a model ID currently enabled in your AIsa account.
AISA_MODEL=choose-a-supported-model-id

# Optional failover chain. Configure distinct provider credentials as server secrets.
# Each item needs model + apiKeyEnv; baseUrl defaults to AISA_BASE_URL.
# This can recover from a provider/model quota limit only if the fallback credential has available quota.
# JARVIS_MODEL_FALLBACKS=[{"model":"fallback-model-id","baseUrl":"https://api.example/v1","apiKeyEnv":"FALLBACK_AI_API_KEY"}]
# FALLBACK_AI_API_KEY=configure-this-in-your-host-secret-manager

# Optional: restrict browser origins to your deployed Jarvis URL.
JARVIS_CORS_ORIGIN=https://your-jarvis-domain.example
